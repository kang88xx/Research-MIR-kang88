generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase: DATABASE_URL은 트랜잭션 풀러(6543, pgbouncer), db push/스키마 작업은 세션 풀러(5432)로 직접 연결
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  nickname     String    @unique
  level        Int       @default(1)
  // 닉네임: 가입 후 총 3회까지 변경. nicknameConfirmed=false(구글 신규)면 최초 1회 설정은 무료.
  nicknameChanges   Int     @default(0)
  nicknameConfirmed Boolean @default(true)
  // 어드민 승인제 — 승인 전에는 로그인해도 사이트 열람 불가(운영진 Lv10+는 항상 통과)
  approved   Boolean   @default(false)
  approvedAt DateTime?
  createdAt    DateTime   @default(now())
  posts        Post[]
  comments     Comment[]
  votes        Vote[]
}

// 외부 API 응답 공유 캐시 — 요청 시점 외부 호출 제거(서버리스 인스턴스 간 공유)
model MarketCache {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

// 고정창 레이트리밋 카운터 (로그인/가입 무차별 대입·남용 방지)
model RateLimit {
  key       String   @id // 예: "login:1.2.3.4" | "register:1.2.3.4"
  count     Int      @default(0)
  resetAt   DateTime
  @@index([resetAt])
}

model MarketSnapshot {
  id           Int      @id @default(autoincrement())
  btcDominance Float
  totalMcapUsd Float
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Board {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  name       String
  type       String  @default("community") // community | info | forum
  coinSymbol String?
  sortOrder  Int     @default(0)
  posts      Post[]
}

model Post {
  id           Int       @id @default(autoincrement())
  board        Board     @relation(fields: [boardId], references: [id])
  boardId      Int
  author       User      @relation(fields: [userId], references: [id])
  userId       String
  title        String
  content      String
  viewCount    Int       @default(0)
  upvotes      Int       @default(0)
  downvotes    Int       @default(0)
  commentCount Int       @default(0)
  isNotice     Boolean   @default(false)
  priceAtPost  Float?
  priceSymbol  String?
  createdAt    DateTime  @default(now())
  comments     Comment[]
  votes        Vote[]

  @@index([boardId, createdAt(sort: Desc)])
  @@index([boardId, upvotes])
}

model Comment {
  id        Int      @id @default(autoincrement())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  author    User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

// 수집·검수 체계: docs/data-collection/README.md (소스 레지스트리·검증 규칙·운영 루틴)
model CalendarEvent {
  id          Int      @id @default(autoincrement())
  date        DateTime
  isTba       Boolean  @default(false)
  ticker      String
  title       String
  description String
  category    String // important | good | bad | neutral (색상 분류)
  groupMain   String   @default("크립토") // 주식 | 크립토 | 매크로 | 이벤트 (필터 대분류)
  groupSub    String   @default("기타") // 필터 소분류
  sourceUrl   String? // 대표 출처 1건 (구 데이터 호환) — 다중 출처는 sources 사용
  // ── 수집·검수 메타 (docs/data-collection/event-schema.json 매핑) ──
  dateStatus  String   @default("confirmed") // confirmed | estimated | tba | revised | postponed | cancelled
  importance  Int      @default(1) // 3=시장 전체 / 2=섹터·종목 중대 / 1=참고
  sources     Json? // [{name, url, tier(1~3), isOfficial}] — 수집된 모든 출처 보존 (T3는 공식 원문 포함 2개 이상)
  reviewStatus String  @default("published") // draft | pending_review | published | needs_recheck | archived
  nextCheck   DateTime? // 다음 재확인일 (언락·실적·규제 = D-7·D-1 / 그 외 = D-1)
  externalId  String?  @unique // 외부 수집기 멱등 키 (예: "coindar:97486") — 수기 입력은 null
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([reviewStatus, nextCheck])
}

model KimpSnapshot {
  id        Int      @id @default(autoincrement())
  btcKrw    Float
  btcUsd    Float
  usdKrw    Float
  kimp      Float
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Vote {
  id     Int    @id @default(autoincrement())
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  user   User   @relation(fields: [userId], references: [id])
  userId String
  value  Int

  @@unique([postId, userId])
}

// 일자별 접속자 집계 (KST 기준 day = "YYYY-MM-DD") — 어드민 "금일 총 접속자"
model VisitStat {
  day       String   @id // KST 날짜 "2026-06-22"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
